# ---------- MySQL ----------
# Note: mapped to host port 3307 (not 3306) to avoid conflicts with any
# native MySQL install or WSL relay already using 3306 on your machine.
MYSQL_ROOT_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=helix_app
DB_PASSWORD=changeme

# ---------- RabbitMQ ----------
RABBITMQ_USER=helix
RABBITMQ_PASSWORD=changeme
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- JWT ----------
# Must be at least 32 characters (256 bits) for HS256 signing.
JWT_SECRET=replace-this-with-a-random-32-plus-character-secret
JWT_EXPIRATION_MS=3600000